<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers">

    <!--
        Scoped control styles for the Settings window. Pulls the shared implicit control styles plus
        this window's keyed styles. Scoped per-window so the implicit styles never leak into
        theme-integration contexts.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/SettingsStyles.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/AchievementGridStyles.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <helpers:ButtonLabelTemplateSelector x:Key="SettingsButtonLabelTemplateSelector">
        <helpers:ButtonLabelTemplateSelector.LabelTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center"/>
            </DataTemplate>
        </helpers:ButtonLabelTemplateSelector.LabelTemplate>
    </helpers:ButtonLabelTemplateSelector>
    <Style TargetType="Button" BasedOn="{StaticResource PlayAch.Button.BaseStyle}">
        <Setter Property="ContentTemplateSelector" Value="{StaticResource SettingsButtonLabelTemplateSelector}"/>
    </Style>
    <!-- Keep collapsed settings groups visible against their parent section. -->
    <Style TargetType="Expander" BasedOn="{StaticResource PlayAch.Expander.BaseStyle}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PlayAch.Brush.Button.Border}"/>
        <Setter Property="Background" Value="{DynamicResource PlayAch.Brush.Button.Background}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
</ResourceDictionary>
